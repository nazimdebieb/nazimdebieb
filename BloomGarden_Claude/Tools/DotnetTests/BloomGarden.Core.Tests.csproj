<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the pure C# core + EditMode tests outside Unity (CI / machines without Unity).
       Source of truth stays in Assets/_BloomGarden; files are linked, not copied.
       LangVersion 9 = the C# version supported by Unity 6. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_BloomGarden/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/_BloomGarden/Scripts/Solvers/**/*.cs" />
    <Compile Include="../../Assets/_BloomGarden/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
